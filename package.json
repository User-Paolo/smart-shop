{
  "name": "smart-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ecommerce storefront and inventory dashboard with demand forecasting",
  "scripts": {
    "build": "tsc -p frontend",
    "watch": "tsc -p frontend --watch",
    "test:unit": "npm run build && node --test \"tests/unit/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/*.test.js\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "~5.9.3"
  }
}
